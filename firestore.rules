rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* This is the real access-control boundary — the admin/main app UIs
     * are just convenience; nothing here trusts client-side role checks. */

    function isSignedIn() { return request.auth != null; }

    // Exact-case match: the owner's address is a lowercase gmail.com
    // address, and request.auth.token.email is Firebase's own record of
    // it — the same value the client SDK's user.email reflects.
    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == 'abdujalilov7707@gmail.com';
    }

    function myUid() { return request.auth.uid; }
    function myDocPath() { return /databases/$(database)/documents/users/$(myUid()); }
    function myDoc() { return get(myDocPath()).data; }
    function haveMyDoc() { return isSignedIn() && exists(myDocPath()); }

    function myStatus() { return haveMyDoc() ? myDoc().status : null; }
    function myRole() { return haveMyDoc() ? myDoc().role : null; }
    function isApproved() { return myStatus() == 'approved'; }
    function isOwner() { return isApproved() && myRole() == 'owner'; }
    function isManager() { return isApproved() && myRole() == 'manager'; }
    function isOwnerOrManager() { return isOwner() || isManager(); }
    function isApprovedTeacher() { return isApproved() && myRole() == 'teacher'; }

    match /users/{uid} {
      // Read your own doc; owner/manager read anyone's; a teacher reads
      // (get or query-by-teacherId) only the students assigned to them.
      allow get: if isSignedIn() && (
        myUid() == uid ||
        isOwnerOrManager() ||
        (isApprovedTeacher() && resource.data.teacherId == myUid())
      );
      allow list: if isOwnerOrManager() ||
        (isApprovedTeacher() && resource.data.teacherId == myUid());

      // A signed-in user creates exactly one profile: their own. The
      // hardcoded owner address bootstraps straight to approved owner;
      // everyone else can only self-create a pending request with no
      // role and no teacher — approval/role/teacher assignment only ever
      // happens via the update rule below, never at creation.
      allow create: if isSignedIn() && myUid() == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (isOwnerEmail()
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'approved')
          ||
          (!isOwnerEmail()
            && request.resource.data.role == null
            && request.resource.data.status == 'pending'
            && request.resource.data.teacherId == null)
        );

      allow update: if isSignedIn() && (
        isOwner() ||
        // Manager: full control over teacher/student/pending accounts,
        // but can never touch (or create) an owner or a manager.
        (isManager()
          && resource.data.role != 'owner' && resource.data.role != 'manager'
          && request.resource.data.role != 'owner' && request.resource.data.role != 'manager') ||
        // Anyone: only their own display name / presence heartbeat.
        (myUid() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastActive', 'updatedAt']))
      );

      allow delete: if isOwner();
    }

    match /progress/{uid} {
      allow get: if isSignedIn() && (
        myUid() == uid ||
        isOwnerOrManager() ||
        (isApprovedTeacher()
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.teacherId == myUid())
      );
      // Own progress only — app.js writes here, nothing else does.
      allow write: if isSignedIn() && myUid() == uid;
    }

    match /events/{eventId} {
      allow get: if isSignedIn() && (
        isOwnerOrManager() ||
        (isApprovedTeacher() && resource.data.teacherId == myUid())
      );
      allow list: if isOwnerOrManager() ||
        (isApprovedTeacher() && resource.data.teacherId == myUid());

      allow create: if isSignedIn() && (
        isOwnerOrManager() ||
        (isApprovedTeacher() && request.resource.data.teacherId == myUid())
      );
      allow update, delete: if isSignedIn() && (
        isOwnerOrManager() ||
        (isApprovedTeacher() && resource.data.teacherId == myUid())
      );
    }
  }
}
